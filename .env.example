MODEL=lfm3
APP=gradio
PORT=7860
HF_TOKEN=
HF_HUB_OFFLINE=0

# Optional: launch the bundled OpenWebUI with compose.openwebui.yaml.
OPENWEBUI_PORT=3000
# COMPOSE_FILE=compose.yaml:compose.openwebui.yaml

# Optional: used only with compose.openwebui.external.yaml.
# OPENWEBUI_NETWORK=your-openwebui-network

# Change these only for a separate, incompatible runtime.
RUNTIME=transformers
DOCKERFILE=docker/Dockerfile
RUNTIME_REQUIREMENTS=docker/requirements.txt
